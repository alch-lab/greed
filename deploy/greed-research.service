[Unit]
Description=greed structured paper-strategy research review
After=network-online.target greed-paper.service
Wants=network-online.target

[Service]
Type=oneshot
PermissionsStartOnly=true
WorkingDirectory=/opt/greed
ExecStart=/opt/greed/target/release/greed research --config config/demo.toml
ExecStartPost=/usr/bin/systemctl start --no-block greed-candidate.service
EnvironmentFile=/etc/greed-research.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=greed-research
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/greed/data/research/agent
User=greed
Group=greed
