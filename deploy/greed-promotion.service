[Unit]
Description=promote an authenticated validated greed strategy candidate
After=network-online.target greed-paper.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/greed
Environment=GREED_PROJECT_DIR=/opt/greed
Environment=GREED_RESEARCH_OUTPUT_DIR=/opt/greed/data/research/agent
Environment=GREED_FRONTEND_DIR=/opt/greed-web
Environment=GREED_BACKEND_SERVICE=greed-paper
ExecStart=/usr/bin/python3 /opt/greed/deploy/promote-research-candidate.py
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/greed /opt/greed/data /opt/greed-candidates
