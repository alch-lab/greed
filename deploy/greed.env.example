# greed 控制面环境变量（复制为 /opt/greed/greed.env，chmod 600，不要提交真实值）

# 前端登录密码（设置后控制面启用鉴权，公网部署必须设置）
GREED_WEB_PASSWORD=改成强密码

# 币安合约 Demo Trading（模拟盘）API 凭证
# 在 https://demo.binance.com → API 管理 创建（旧 testnet.binancefuture.com 已停用）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 币安现货 Demo Trading（carry 现货腿；与合约 Demo 共用同一对 key 即可）
# 同在 https://demo.binance.com → API 管理 创建
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=

# 日志级别
RUST_LOG=info

# 出口代理（币安 API/WS 不可直连的网络环境才需要）
# GREED_PROXY=http://127.0.0.1:7897
