[Unit]
Description=build and publish a validated greed strategy candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/greed
EnvironmentFile=/etc/greed-research.env
Environment=GREED_PROJECT_DIR=/opt/greed
Environment=GREED_RESEARCH_OUTPUT_DIR=/opt/greed/data/research/agent
Environment=GREED_CANDIDATE_ROOT=/opt/greed-candidates
Environment=PATH=/root/.cargo/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 /opt/greed/deploy/build-research-candidate.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/greed/.git /opt/greed/data/research/agent /opt/greed-candidates
