# greed 公网部署：Caddy 反向代理 + 自动 HTTPS
#
# 前置：域名 A 记录指向服务器 IP，防火墙放行 80/443（Caddy 自动签 Let's Encrypt 证书）。
# 把 greed.example.com 换成你的域名。

greed.example.com {
	# gzip is deliberately preferred over zstd here. Some embedded browsers and
	# older WebViews advertise zstd but fail to decode ES modules, leaving the UI
	# completely blank. gzip keeps the dashboard compatible with those clients.
	encode gzip

	# API → 控制面（只监听本机 127.0.0.1:8088，不直接暴露）
	handle /api/* {
		reverse_proxy 127.0.0.1:8088
	}

	# 前端静态文件（greed-web 构建产物）+ SPA 路由回退
	handle {
		root * /opt/greed-web/dist
		try_files {path} /index.html
		file_server
	}

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/greed-access.log
	}
}
